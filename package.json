    "react-dom": "latest",
    "shadcn": "^4.18.0",
    "shiki": "^4.4.3",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "latest",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
