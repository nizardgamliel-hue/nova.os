{
  "name": "nova-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- node --import tsx scripts/migrate-test-db.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "crm:local-db": "node --import tsx scripts/crm-local-db.ts",
    "crm:worker": "dotenv -e .env.local -- node scripts/crm-worker.mjs"
  },
  "dependencies": {
