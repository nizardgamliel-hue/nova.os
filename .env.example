# Preferred: Vercel AI Gateway. Never commit real values.
AI_GATEWAY_API_KEY=
NOVA_GATEWAY_READY=false
NOVA_MODEL=poolside/laguna-s-2.1-free

# Required for durable conversations, memory and audit in the next configuration step.
DATABASE_URL=
NOVA_CRM_VALIDATED=false
NOVA_SAAS_VALIDATED=false
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Auth provider credentials will be added after provider selection.
AUTH_SECRET=
