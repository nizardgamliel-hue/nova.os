# Preferred: Vercel AI Gateway. Never commit real values.
AI_GATEWAY_API_KEY=
NOVA_GATEWAY_READY=false
NOVA_MODEL=poolside/laguna-s-2.1-free

# Required for durable conversations, memory and audit in the next configuration step.
DATABASE_URL=
NOVA_CRM_VALIDATED=false
NOVA_SAAS_VALIDATED=false
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Auth provider credentials will be added after provider selection.
AUTH_SECRET=

# Nova CRM pilot: use an isolated development/test database only.
NOVA_DATABASE_ENV=test
# Remote migration safety: independently identify the permitted test destination.
NOVA_TEST_DB_HOST=
NOVA_TEST_DB_NAME=
# Local development alternative (never enabled in production).
NOVA_LOCAL_TEST_DB_PATH=

# Real e-mail sending (Resend): configure a verified sender; never commit credentials.
RESEND_API_KEY=
NOVA_EMAIL_FROM=
# Only these addresses AND contacts explicitly marked as test are eligible for automatic sends.
NOVA_TEST_EMAIL_ALLOWLIST=
# Server worker/cron authentication. Not an e-mail-provider credential.
CRON_SECRET=
NOVA_CRM_WORKER_URL=http://localhost:3000/api/cron/crm-followups
